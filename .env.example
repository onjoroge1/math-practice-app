# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js / NextAuth v5)
# Generate with: npx auth secret
AUTH_SECRET=your-auth-secret-here
# Required locally and behind trusted reverse proxies. Vercel sets this automatically.
AUTH_TRUST_HOST=true

# Family parent portal. Keep the password in environment variables only.
PARENT_ADMIN_USERNAME=admin
PARENT_ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters

# Vercel Analytics (auto-configured on Vercel, optional locally)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
